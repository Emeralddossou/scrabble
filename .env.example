# MySQL (production / Vercel)
DB_TYPE=mysql
DATABASE_URL=mysql://user:password@host:3306/scrabble

# SQLite/libSQL (local or persistent Node host only)
# DB_TYPE=sqlite
# DATABASE_URL=file:./data/scrabble-v2.db

AUTH_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://localhost:3000

# Password reset delivery through Resend (required in production)
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=LexiForge <noreply@example.com>

# Web Push : générer une paire une seule fois avec `npx web-push generate-vapid-keys`.
# La clé privée et CRON_SECRET ne doivent jamais être committés ni exposés au navigateur.
VAPID_PUBLIC_KEY=replace-with-the-public-vapid-key
VAPID_PRIVATE_KEY=replace-with-the-private-vapid-key
VAPID_SUBJECT=mailto:admin@example.com
CRON_SECRET=replace-with-a-long-random-cron-secret
