# MySQL (production / Vercel)
DB_TYPE=mysql
DATABASE_URL=mysql://user:password@host:3306/scrabble

# SQLite/libSQL (local or persistent Node host only)
# DB_TYPE=sqlite
# DATABASE_URL=file:./data/scrabble-v2.db

AUTH_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://localhost:3000

# Password reset delivery through Resend (required in production)
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=LexiForge <noreply@example.com>
